+/* The allocator cursor can be ahead of consumption. Hints are confined to
+ * this worker's current logical ownership range, with no duplicated ranges. */
+static void
+PrefetchOwnedRange(SeqScanReadStreamState &state, ParallelBlockTableScanDesc pbscan,
+                   ParallelBlockTableScanWorker worker, bool new_chunk, BlockNumber page)
+{
+    if (!state.os_prefetch_enabled || page == InvalidBlockNumber)
+        return;
+
+    const uint64_t logical = worker->phsw_nallocated;
+    const uint64_t nblocks = pbscan->phs_nblocks;
+    if (new_chunk) {
+        state.os_prefetch_chunk_end = std::min<uint64_t>(nblocks, logical + worker->phsw_chunk_size);
+        state.os_prefetch_next = logical;
+        state.os_prefetch_trigger = logical;
+        ++state.os_prefetch_chunks;
+    }
+    if (logical < state.os_prefetch_trigger || state.os_prefetch_next >= state.os_prefetch_chunk_end)
+        return;
+
+    const uint64_t target = std::min<uint64_t>(state.os_prefetch_chunk_end,
+                                             logical + state.os_prefetch_pages);
+    uint64_t next = state.os_prefetch_next;
+    while (next < target) {
+        const BlockNumber first = static_cast<BlockNumber>((next + pbscan->phs_startblock) % nblocks);
+        const uint32_t count = static_cast<uint32_t>(std::min<uint64_t>(target - next, nblocks - first));
+        const uint64_t begin = BlockTraceClock();
+        // smgr splits file-segment boundaries; relation wrap is split here.
+        const bool advised = smgrprefetch(RelationGetSmgr(state.scan->rs_base.rs_rd),
+                                         MAIN_FORKNUM, first, static_cast<int>(count));
+        const uint64_t end = BlockTraceClock();
+        ++state.os_prefetch_calls;
+        state.os_prefetch_pages_hinted += count;
+        state.os_prefetch_ns += end - begin;
+        if (!advised) ++state.os_prefetch_failed_calls;
+        BlockTraceRecord(state.block_trace, "OS_PREFETCH", begin, end, 0, first,
+                         count, count, -1, InvalidBuffer);
+        next += count;
+    }
+    state.os_prefetch_next = next;
+    const uint64_t step = std::max<uint32_t>(1, state.os_prefetch_pages / 2);
+    state.os_prefetch_trigger = next >= state.os_prefetch_chunk_end
+        ? state.os_prefetch_chunk_end : next - std::min(next, step);
