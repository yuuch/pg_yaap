+#!/usr/bin/env python3
+"""Check bounded OS hints against actual parallel scan ownership and results."""
+import argparse
+import json
+import os
+from pathlib import Path
+import time
+
+import memory_runtime as runtime
+import scan_block_trace as trace
+import scan_io_profile as io_profile
+
+OUT = runtime.OUT
+SCHEMA = f'yaap_os_prefetch_{os.getpid()}'
+CAPACITY = 65536
+
+
+def hint_pages(assigns, hints, pages, distance):
+    """Validate one source's physical hint ranges, including wrapped ownership."""
+    seen = set()
+    for event in hints:
+        first, count = int(event['block']), int(event['pages'])
+        assert 0 < count <= distance, event
+        assert 0 <= first < pages and first + count <= pages, event
+        assert int(event['last_block']) == first + count - 1, event
+        assert int(event['request']) == 0 and int(event['need_wait']) == -1
+        assert int(event['end_ns']) >= int(event['time_ns']) > 0
+        blocks = set(range(first, first + count))
+        assert not seen.intersection(blocks), ('repeated hint', event)
+        assert any(all((block - int(owner['block'])) % pages < int(owner['pages'])
+                       for block in blocks) for owner in assigns), ('hint outside ownership', event)
+        seen.update(blocks)
+    return seen
+
+
+def self_test():
+    def hint(block, count):
+        return dict(block=block, pages=count, last_block=block+count-1,
+                    request=0, need_wait=-1, time_ns=1, end_ns=2)
+    owners = [dict(block=7, pages=5)]
+    assert hint_pages(owners, [hint(7, 3), hint(0, 2)], 10, 4) == {7, 8, 9, 0, 1}
+    for bad in ([hint(9, 2)], [hint(2, 1)], [hint(7, 2), hint(8, 2)], [hint(7, 5)]):
+        try:
+            hint_pages(owners, bad, 10, 4)
+        except AssertionError:
+            pass
+        else:
+            raise AssertionError(('bad range accepted', bad))
+    print('5 OS hint range checks passed')
+
+
+def server_delta(log, offset):
+    time.sleep(.1)
+    assert log.stat().st_size >= offset, 'server log rotated during test'
+    with log.open('rb') as source:
+        source.seek(offset)
+        return source.read().decode(errors='replace')
+
+
+def main():
+    if not trace.LOG:
+        raise SystemExit('Set YAAP_BLOCK_TRACE_LOG to a dedicated nonrotating PG server log')
+    OUT.mkdir(parents=True, exist_ok=True)
+    table = f'{SCHEMA}.a'
+    runtime.ddl(f'CREATE SCHEMA {SCHEMA}; CREATE TABLE {table} AS SELECT '
+                "i::bigint AS id,(i%17)::int AS k,repeat('x',96)::text AS padding "
+                'FROM generate_series(1,60000) i; '
+                f'CREATE TABLE {SCHEMA}.empty AS SELECT * FROM {table} WHERE false; '
+                f'ANALYZE {table}; ANALYZE {SCHEMA}.empty;')
+    results = []
+    try:
+        pages = int(runtime.checked(f"SELECT pg_relation_size('{table}')/current_setting('block_size')::bigint;"))
+        checksum = f'SELECT count(*),sum(id),sum(id*id) FROM {table};'
+        cases = [
+            ('off', checksum, 1, 0, 128, 'yaap', True),
+            ('single-32', checksum, 1, 32, 128, 'yaap', True),
+            ('multi-32', checksum, 4, 32, 128, 'yaap', True),
+            ('multi-256', checksum, 4, 256, 128, 'yaap', True),
+            ('single-1024', checksum, 1, 1024, 128, 'yaap', True),
+            ('small-pin-window', checksum, 4, 256, 17, 'yaap', True),
+            ('reject', f'SELECT id FROM {table} WHERE id<0;', 4, 32, 128, 'yaap', True),
+            ('empty', f'SELECT id FROM {SCHEMA}.empty;', 4, 1024, 128, 'yaap', True),
+            ('limit', f'SELECT 1 FROM {table} LIMIT 7;', 4, 1024, 128, 'yaap', False),
+            ('native', checksum, 4, 1024, 128, 'pg', True),
+        ]
+        for name, sql, workers, distance, window, stream, full_scan in cases:
+            expected = runtime.checked('SET pg_yaap.enabled=off;' + sql)
+            prefix = OUT/f'{name}-{time.time_ns()}'
+            setup = runtime.setup(workers, '512MB') + (
+                'SET pg_yaap.parallel_leader_participation=off; '
+                'SET io_combine_limit=16; SET pg_yaap.scan_prefetch_batch_pages=16; '
