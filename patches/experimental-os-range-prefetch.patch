+                'SET pg_yaap.profile=off; SET pg_yaap.profile_scan=off; '
+                'SET pg_yaap.profile_scan_io=detail; SET pg_yaap.profile_timeline=trace; '
+                f"SET pg_yaap.profile_trace_file='{prefix}'; "
